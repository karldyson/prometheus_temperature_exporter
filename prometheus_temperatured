import socket
import time
import sys
import os
import json
import re
import math
import getopt
import configparser
from prometheus_client import start_http_server, Gauge, Counter

"""
define our config class with our default values
"""
class config:
	server_port = 8000
	bind_to_ip = "0.0.0.0"
	multicast_group = "239.0.0.1"
	multicast_port = 11235
	ranges_file = None

"""
our version number
"""
version = '3.0'

"""
the packet types we accept
"temperature" is the legacy type sent by older probes, "reading" is sent by newer probes
and may carry any mix of measurements
"""
PACKET_TYPES = ("temperature", "reading")

"""
define our usage
"""
def usage():
	print("""
 {0} version {1}
 Usage: {0} [options]

  Options:
   -s N		The port for the server to listen on (default: tcp/{2})
   -i N		The IP to bind to (default: {3})
   -g N		The multicast group to join (default: {4})
   -p N		The multicast port to listen for (default: {5})
   -r FILE	Per-sensor measurement ranges file (default: built-in ranges)
   -h		This help
	""".format(os.path.basename(sys.argv[0]), version, config.server_port, config.bind_to_ip, config.multicast_group, config.multicast_port))
	sys.exit(4)

"""
output a timestamped line for the log/console
"""
def log(message):
	current_time = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime())
	print(f"{current_time} {message}")

"""
parse our command line options and show usage if there's an exception
"""
try:
	(options, args) = getopt.getopt(sys.argv[1:], 's:i:g:p:r:h')
except getopt.GetoptError as e:
	print(f"Error: {e}")
	usage()

"""
update the config depending on the command line options
"""
for (opt, optval) in options:
	match opt:
		case '-s': config.server_port = int(optval)
		case '-i': config.bind_to_ip = optval
		case '-g': config.multicast_group = optval
		case "-p": config.multicast_port = int(optval)
		case "-r": config.ranges_file = optval
		case "-h": usage()

"""
initialise the metrics
a packet's name is a location (e.g. Kitchen), not a probe: several sensors may report for one
location, each sending different measurements, so everything except sensor_info is per location
the measurement gauges hold the actual values, one gauge per measurement type
sensor_last_seen_timestamp is updated for every valid packet, so we can alert if a location goes
quiet; with several sensors at one location it only shows that one of them is still sending
sensor_measurement_last_seen_timestamp is updated per accepted measurement, so we can alert if a
single sensor stops giving us good values while others at the same location are still sending
sensor_measurement_rejected counts measurements we discarded, and why
sensor_info carries each sensor's model, firmware and version as labels with a constant value of 1,
keyed by location and the packet's sensor field (sensor_id)
"""
temp_gauge = Gauge('temperature', "Temperature (Celsius)", ['friendly_name', 'sensor_name'])
humidity_gauge = Gauge('humidity', "Relative Humidity (%)", ['friendly_name', 'sensor_name'])
co2_gauge = Gauge('co2', "CO2 Concentration (ppm)", ['friendly_name', 'sensor_name'])
last_seen_gauge = Gauge('sensor_last_seen_timestamp', "Probe Last Seen Timestamp", ['friendly_name', 'sensor_name'])
measurement_last_seen_gauge = Gauge('sensor_measurement_last_seen_timestamp', "Measurement Last Accepted Timestamp", ['friendly_name', 'sensor_name', 'measurement'])
rejected_counter = Counter('sensor_measurement_rejected', "Measurements Rejected", ['sensor_name', 'measurement', 'reason'])
info_gauge = Gauge('sensor_info', "Sensor Information", ['sensor_name', 'sensor_id', 'model', 'fw', 'version'])

"""
the measurements we know about: the packet field, the gauge it updates, and the built-in
range of acceptable values (min, max), used when the ranges file doesn't say otherwise
to add a new measurement, add a gauge above and a line here
"""
MEASUREMENTS = (
	("temperature", temp_gauge, (-55.0, 125.0)),
	("humidity", humidity_gauge, (0.0, 100.0)),
	("co2", co2_gauge, (0.0, 40000.0)),
)

"""
load the per-sensor ranges file, if we have one
the [DEFAULT] section applies to every sensor, a section named after a sensor overrides it
we return the default ranges plus a dict of per-sensor ranges, each a dict of measurement -> (min, max)
any problem with the file is fatal; better to refuse to start than run with ranges we didn't intend
"""
def load_ranges(path):
	default_ranges = {name: limits for (name, gauge, limits) in MEASUREMENTS}
	sensor_ranges = {}
	if path is None:
		return (default_ranges, sensor_ranges)

	def fail(message):
		print(f"Error in ranges file {path}: {message}")
		sys.exit(3)

	def parse_section(section_name, items):
		ranges = dict(default_ranges)
		for (key, value) in items.items():
			if key not in default_ranges:
				fail(f"[{section_name}] unknown measurement '{key}' (known: {', '.join(default_ranges)})")
			try:
				(low, high) = (float(part) for part in value.split(":"))
			except ValueError:
				fail(f"[{section_name}] {key} = {value}: expected min:max, e.g. -10:45")
			if not (math.isfinite(low) and math.isfinite(high) and low < high):
				fail(f"[{section_name}] {key} = {value}: min must be less than max")
			ranges[key] = (low, high)
		return ranges

	parser = configparser.ConfigParser(inline_comment_prefixes=(";", "#"))
	try:
		with open(path) as f:
			parser.read_file(f)
	except (OSError, configparser.Error) as e:
		fail(e)

	default_ranges = parse_section("DEFAULT", parser.defaults())
	for section in parser.sections():
		"""section items include the inherited [DEFAULT] values"""
		sensor_ranges[section] = parse_section(section, parser[section])
	return (default_ranges, sensor_ranges)

(default_ranges, sensor_ranges) = load_ranges(config.ranges_file)

"""
create the udp socket, bind to the multicast group and port, and subscribe to the multicast group
"""
mbin = bytes(map(int, config.multicast_group.split("."))) + bytes(4)
sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP)
sock.bind((config.bind_to_ip, config.multicast_port))
sock.setsockopt(socket.IPPROTO_IP, socket.IP_ADD_MEMBERSHIP, mbin)

"""
start the prometheus server and output a confirmation
"""
start_http_server(config.server_port)
print(f"HTTP Server Started on tcp/{config.server_port}, listening for multicast on {config.multicast_group}:{config.multicast_port}")
if config.ranges_file:
	print(f"Measurement ranges loaded from {config.ranges_file} ({len(sensor_ranges)} sensor override(s))")

"""
remember each sensor's current info labels, keyed by (location, sensor id), so we can remove the
old set when they change; otherwise the old label set would continue to be exported
keying by location alone would make sensor_info flap between sensors sharing a location
"""
info_labels = {}

"""
check a single measurement value, returning None if it's acceptable or the reason if not
"""
def check_measurement(value, limits):
	if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value):
		return "invalid"
	if not (limits[0] <= value <= limits[1]):
		return "out_of_range"
	return None

"""
now we loop around grabbing packets from the network
"""
while True:
	"""grab the packet from the network and output it for the log/console"""
	data, address = sock.recvfrom(1024)
	log(f"{address}: {data.decode(errors='replace')}")

	"""
	decode the packet and grab the sensor details from the json
	a bad packet is logged and skipped; it must never stop the loop
	"""
	try:
		sensor = json.loads(data.decode())
		if not isinstance(sensor, dict):
			raise TypeError("packet is not a JSON object")

		"""we are only interested in packet types that carry measurements"""
		if sensor.get("type") not in PACKET_TYPES: continue

		"""work out the sensor name and make it a friendly name"""
		stripped_name = "".join(sensor["name"].split())
		if not stripped_name:
			raise ValueError("empty sensor name")
		friendly_name = " ".join(re.sub(r"([A-Z])", r" \1", stripped_name).split())

		"""optional details, older probes may not send some or all of these"""
		sensor_id = str(sensor.get("sensor", ""))
		info = tuple(str(sensor.get(field, "")) for field in ("model", "fw", "version"))
	except (UnicodeDecodeError, ValueError, KeyError, TypeError, AttributeError) as e:
		log(f"{address}: ignoring packet: {type(e).__name__}: {e}")
		continue

	"""the probe is alive, whatever state its measurements are in"""
	now = time.time()
	last_seen_gauge.labels(friendly_name=friendly_name, sensor_name=stripped_name).set(now)

	"""update the info metric, removing the previous label set if it has changed"""
	info_key = (stripped_name, sensor_id)
	previous_info = info_labels.get(info_key)
	if previous_info != info:
		if previous_info is not None:
			info_gauge.remove(stripped_name, sensor_id, *previous_info)
		info_gauge.labels(stripped_name, sensor_id, *info).set(1)
		info_labels[info_key] = info

	"""
	check and record each measurement independently, so one bad value never discards the others
	a measurement that's absent from the packet is simply skipped
	"""
	ranges = sensor_ranges.get(stripped_name, default_ranges)
	accepted = 0
	for (measurement, gauge, limits) in MEASUREMENTS:
		if measurement not in sensor: continue
		value = sensor[measurement]
		reason = check_measurement(value, ranges[measurement])
		if reason:
			rejected_counter.labels(sensor_name=stripped_name, measurement=measurement, reason=reason).inc()
			log(f"{address}: {stripped_name}: rejected {measurement} {value!r} ({reason}, allowed {ranges[measurement][0]:g}:{ranges[measurement][1]:g})")
			continue
		gauge.labels(friendly_name=friendly_name, sensor_name=stripped_name).set(value)
		measurement_last_seen_gauge.labels(friendly_name=friendly_name, sensor_name=stripped_name, measurement=measurement).set(now)
		accepted += 1

	if not accepted:
		log(f"{address}: {stripped_name}: warning: packet contained no acceptable measurements")
