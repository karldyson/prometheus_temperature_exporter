{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "The Prometheus data source that scrapes prometheus_temperatured",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" }
  ],
  "uid": "temperatured-temperature",
  "title": "Temperature",
  "description": "Temperature from prometheus_temperatured, for every location that sends it (DS18B20, SHT3x, or an SCD4x set to publish temperature).",
  "tags": ["temperature"],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 41,
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "annotations": { "list": [] },
  "links": [
    {
      "type": "dashboards",
      "title": "Overview",
      "tags": ["environment"],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "friendly_name",
        "label": "Location",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(temperature, friendly_name)",
        "query": {
          "qryType": 1,
          "query": "label_values(temperature, friendly_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {},
        "options": [],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Temperature now",
      "description": "Blue below 3 °C, where pipes, tanks and plants are at risk of frost.",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max by (friendly_name, sensor_name) (temperature{friendly_name=~\"$friendly_name\"})",
          "legendFormat": "{{friendly_name}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "text", "value": 3 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Temperature",
      "description": "The legend shows the minimum, mean and maximum over the dashboard's time range, and the last value. Click a column heading to sort.",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max by (friendly_name, sensor_name) (temperature{friendly_name=~\"$friendly_name\"})",
          "legendFormat": "{{friendly_name}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["min", "mean", "max", "lastNotNull"],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Rate of change",
      "description": "How fast each location is warming (above zero) or cooling (below zero), in °C per hour, over a 15-minute window. Shows heating coming on or going off, a door or window left open, or a tank refilling.",
      "gridPos": { "x": 0, "y": 19, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "deriv(max by (friendly_name, sensor_name) (temperature{friendly_name=~\"$friendly_name\"})[15m:1m]) * 3600",
          "legendFormat": "{{friendly_name}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: °C/h",
          "decimals": 1,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Seconds since last temperature reading",
      "description": "Time since the exporter last accepted a temperature for each location. Units send every 10 s, so this should stay under about 20 s. At a location with several sensors, this shows that the sensor providing temperature has stopped, even while the others there are still sending.",
      "gridPos": { "x": 0, "y": 27, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "time() - max by (friendly_name, sensor_name) (sensor_measurement_last_seen_timestamp{measurement=\"temperature\", friendly_name=~\"$friendly_name\"})",
          "legendFormat": "{{friendly_name}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "min": 0,
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "red", "value": 60 }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMax": 90,
            "thresholdsStyle": { "mode": "area" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Rejected temperature readings",
      "description": "Temperatures the exporter discarded: 'out_of_range' is outside the ranges file (e.g. a DS18B20's 85.0 power-on value) and 'invalid' isn't a number. An occasional one is harmless; a steady stream points at wiring or a failing sensor. Empty is good.",
      "gridPos": { "x": 12, "y": 27, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (sensor_name, reason) (increase(sensor_measurement_rejected_total{measurement=\"temperature\"}[$__rate_interval])) and on (sensor_name) max by (sensor_name) (temperature{friendly_name=~\"$friendly_name\"})",
          "legendFormat": "{{sensor_name}} {{reason}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    }
  ]
}
