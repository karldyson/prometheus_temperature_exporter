{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "The Prometheus data source that scrapes prometheus_temperatured",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" }
  ],
  "uid": "temperatured-environment",
  "title": "Environment",
  "description": "Overview of every location from prometheus_temperatured: what needs attention, the latest temperature, humidity, CO2 and dew point margin, and trends. Pick a location to narrow everything to it; the links go to the Temperature, Humidity and CO2 dashboards for detail.",
  "tags": ["environment"],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 41,
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "annotations": { "list": [] },
  "links": [
    {
      "type": "dashboards",
      "title": "Detail",
      "tags": ["temperature"],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "friendly_name",
        "label": "Location",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(sensor_last_seen_timestamp, friendly_name)",
        "query": {
          "qryType": 1,
          "query": "label_values(sensor_last_seen_timestamp, friendly_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {},
        "options": [],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Silent locations",
      "description": "Locations the exporter has had no packet from for over 60 s. Units send every 10 s.",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "links": [{ "title": "Temperature detail", "url": "/d/temperatured-temperature/temperature?${friendly_name:queryparam}&${__url_time_range}" }],
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "count((time() - max by (friendly_name) (sensor_last_seen_timestamp{friendly_name=~\"$friendly_name\"})) > 60) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Stale measurements",
      "description": "Measurements (temperature, humidity, CO2) not accepted for over 60 s, counted per location. This catches one dead sensor at a location where other sensors are still sending, which 'Silent locations' can't.",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "links": [{ "title": "Temperature detail", "url": "/d/temperatured-temperature/temperature?${friendly_name:queryparam}&${__url_time_range}" }],
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "count((time() - max by (friendly_name, measurement) (sensor_measurement_last_seen_timestamp{friendly_name=~\"$friendly_name\"})) > 60) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Rejected readings (1 h)",
      "description": "Measurements the exporter discarded in the last hour, as invalid or outside the ranges file (e.g. a DS18B20's 85.0 power-on value). An occasional one is harmless; a steady stream points at wiring or a failing sensor.",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "links": [{ "title": "Temperature detail", "url": "/d/temperatured-temperature/temperature?${friendly_name:queryparam}&${__url_time_range}" }],
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "round(sum(sum by (sensor_name) (increase(sensor_measurement_rejected_total[1h])) and on (sensor_name) max by (sensor_name) (sensor_last_seen_timestamp{friendly_name=~\"$friendly_name\"}))) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 10 }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Below 3 °C",
      "description": "Locations colder than 3 °C, where pipes, tanks and plants are at risk of frost. An outdoor sensor will often count here in winter.",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "links": [{ "title": "Temperature detail", "url": "/d/temperatured-temperature/temperature?${friendly_name:queryparam}&${__url_time_range}" }],
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "count(max by (friendly_name) (temperature{friendly_name=~\"$friendly_name\"}) < 3) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "blue", "value": 1 }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Condensation risk",
      "description": "Locations whose air is within 3 °C of its dew point, where windows and cold walls are likely to get condensation. Needs humidity and the recording rules in prometheus_temperatured.rules.yml.",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "links": [{ "title": "Humidity detail", "url": "/d/temperatured-humidity/humidity?${friendly_name:queryparam}&${__url_time_range}" }],
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "count((max by (friendly_name) (temperature{friendly_name=~\"$friendly_name\"}) - max by (friendly_name) (sensor:dewpoint{friendly_name=~\"$friendly_name\"})) < 3) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "CO2 above 1000 ppm",
      "description": "Locations with CO2 above 1000 ppm, the usual level to open a window.",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "links": [{ "title": "CO2 detail", "url": "/d/temperatured-co2/co2?${friendly_name:queryparam}&${__url_time_range}" }],
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "count(max by (friendly_name) (co2{friendly_name=~\"$friendly_name\"}) > 1000) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Locations",
      "description": "The latest values for each location. A blank cell means the location doesn't send that measurement. Click a location to narrow this dashboard to it, or a value to open its detail dashboard.",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 11 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max by (friendly_name) (temperature{friendly_name=~\"$friendly_name\"})",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max by (friendly_name) (humidity{friendly_name=~\"$friendly_name\"})",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max by (friendly_name) (temperature{friendly_name=~\"$friendly_name\"}) - max by (friendly_name) (sensor:dewpoint{friendly_name=~\"$friendly_name\"})",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max by (friendly_name) (co2{friendly_name=~\"$friendly_name\"})",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "E",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "time() - max by (friendly_name) (sensor_last_seen_timestamp{friendly_name=~\"$friendly_name\"})",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": { "friendly_name": 0, "Value #A": 1, "Value #B": 2, "Value #C": 3, "Value #D": 4, "Value #E": 5 },
            "renameByName": {
              "friendly_name": "Location",
              "Value #A": "Temperature",
              "Value #B": "Humidity",
              "Value #C": "Above dew point",
              "Value #D": "CO2",
              "Value #E": "Last seen"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "",
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Location" },
            "properties": [
              { "id": "links", "value": [{ "title": "Show only ${__data.fields.Location}", "url": "/d/temperatured-environment/environment?var-friendly_name=${__data.fields.Location:percentencode}&${__url_time_range}" }] }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Temperature" },
            "properties": [
              { "id": "unit", "value": "celsius" },
              { "id": "decimals", "value": 1 },
              { "id": "color", "value": { "mode": "thresholds" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }, { "color": "text", "value": 3 }] } },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "links", "value": [{ "title": "Temperature detail", "url": "/d/temperatured-temperature/temperature?var-friendly_name=${__data.fields.Location:percentencode}&${__url_time_range}" }] }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Humidity" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 0 },
              { "id": "color", "value": { "mode": "thresholds" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }, { "color": "green", "value": 40 }, { "color": "orange", "value": 60 }, { "color": "red", "value": 70 }] } },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "links", "value": [{ "title": "Humidity detail", "url": "/d/temperatured-humidity/humidity?var-friendly_name=${__data.fields.Location:percentencode}&${__url_time_range}" }] }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Above dew point" },
            "properties": [
              { "id": "unit", "value": "celsius" },
              { "id": "decimals", "value": 1 },
              { "id": "color", "value": { "mode": "thresholds" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 3 }, { "color": "text", "value": 5 }] } },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "description", "value": "Air temperature minus dew point. Below about 3 °C, expect condensation on windows and cold walls." },
              { "id": "links", "value": [{ "title": "Humidity detail", "url": "/d/temperatured-humidity/humidity?var-friendly_name=${__data.fields.Location:percentencode}&${__url_time_range}" }] }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "CO2" },
            "properties": [
              { "id": "unit", "value": "ppm" },
              { "id": "decimals", "value": 0 },
              { "id": "color", "value": { "mode": "thresholds" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 800 }, { "color": "orange", "value": 1000 }, { "color": "red", "value": 1400 }] } },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "links", "value": [{ "title": "CO2 detail", "url": "/d/temperatured-co2/co2?var-friendly_name=${__data.fields.Location:percentencode}&${__url_time_range}" }] }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Last seen" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "decimals", "value": 0 },
              { "id": "color", "value": { "mode": "thresholds" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "text", "value": null }, { "color": "red", "value": 60 }] } },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "description", "value": "Seconds since the last packet from any sensor at the location. Units send every 10 s." }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [{ "displayName": "Location", "desc": false }],
        "footer": { "show": false, "reducer": ["sum"], "fields": "" }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Temperature",
      "gridPos": { "x": 0, "y": 15, "w": 8, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "links": [{ "title": "Temperature detail", "url": "/d/temperatured-temperature/temperature?${friendly_name:queryparam}&${__url_time_range}" }],
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max by (friendly_name, sensor_name) (temperature{friendly_name=~\"$friendly_name\"})",
          "legendFormat": "{{friendly_name}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Relative humidity",
      "gridPos": { "x": 8, "y": 15, "w": 8, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "links": [{ "title": "Humidity detail", "url": "/d/temperatured-humidity/humidity?${friendly_name:queryparam}&${__url_time_range}" }],
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max by (friendly_name, sensor_name) (humidity{friendly_name=~\"$friendly_name\"})",
          "legendFormat": "{{friendly_name}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "CO2",
      "description": "Shaded bands: yellow from 800 ppm, orange from 1000 ppm (ventilate), red from 1400 ppm.",
      "gridPos": { "x": 16, "y": 15, "w": 8, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "links": [{ "title": "CO2 detail", "url": "/d/temperatured-co2/co2?${friendly_name:queryparam}&${__url_time_range}" }],
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max by (friendly_name, sensor_name) (co2{friendly_name=~\"$friendly_name\"})",
          "legendFormat": "{{friendly_name}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ppm",
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "yellow", "value": 800 },
              { "color": "orange", "value": 1000 },
              { "color": "red", "value": 1400 }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 400,
            "axisSoftMax": 1200,
            "thresholdsStyle": { "mode": "area" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    }
  ]
}
